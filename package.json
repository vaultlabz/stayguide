{
  "name": "stayguide",
  "version": "1.0.0",
  "description": "Multi-tenant SaaS platform for rental property management",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "tsc && cp -r src/views dist/",
    "build:clean": "rm -rf dist && npm run build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "ts-node tests/e2e/unit-test.ts",
    "test:e2e": "node tests/e2e/offline-test.js && node tests/e2e/phase3-test.js && node tests/e2e/phase5-test.js && node tests/e2e/design-test.js && node tests/e2e/content-test.js"
  },
  "keywords": [
    "rental",
    "property",
    "saas",
    "multi-tenant"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "@types/sharp": "^0.31.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "mysql2": "^3.6.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.4.5",
    "@types/qrcode": "^1.5.6",
    "nodemon": "^3.0.1",
    "playwright-core": "^1.63.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
