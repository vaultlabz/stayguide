# StayGuide production settings (Plesk). Copy to .env on the server and fill in every value.
# 2026-10-09 08:30, #46: rewritten to cover every setting the app reads. The server refuses to start in production
# while a required value (marked REQUIRED) is missing or a placeholder; optional gaps are logged as warnings.
# Generate secrets with: openssl rand -hex 32

NODE_ENV=production
# Plesk Node.js assigns PORT itself; leave it unset there
PORT=3000
# REQUIRED (Plesk nginx proxies to Node; 1 = trust one proxy hop so rate limits see real client IPs)
# 2026-10-10 19:27, #59 other sites allowed to call the API from a browser (comma-separated). Leave empty: StayGuide needs none
CORS_ORIGINS=
TRUST_PROXY=1
# REQUIRED: the public https:// address, no trailing slash
APP_BASE_URL=https://yourdomain.com

# Database (MySQL on Plesk). REQUIRED: MOCK_DATABASE=false
MOCK_DATABASE=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# REQUIRED: 32+ random characters
JWT_SECRET=
JWT_EXPIRES_IN=7d
# REQUIRED: 32 bytes hex. Encrypts property access codes and QR tokens. Back it up: losing it makes saved codes unreadable
OPS_SECRET_KEY=
# Private job photos (default: storage/ops inside the app folder). Keep it outside httpdocs/public and in backups
OPS_STORAGE_DIR=
# Hourly Ops checks (insurance reminders, schedules, overdue alerts). Set to off to disable
OPS_SCHEDULER=

# Admin contact
ADMIN_EMAIL=admin@yourdomain.com
# Receives new helpdesk tickets (falls back to ADMIN_EMAIL)
SUPPORT_EMAIL=
# 2026-10-22 11:01, #63 shown on /terms and /privacy: the company that runs StayGuide and the state whose law applies
LEGAL_NAME=
LEGAL_JURISDICTION=

# Email. smtp sends for real; mock only logs (warning in production)
EMAIL_PROVIDER=smtp
FROM_EMAIL=billing@yourdomain.com
FROM_NAME=StayGuide
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Worker push notifications. Generate once: npx web-push generate-vapid-keys (never change them afterwards)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# Stripe (docs/BILLING_SETUP.md). Live keys: sk_live_... Empty = billing off.
# STRIPE_WEBHOOK_SECRET is REQUIRED once STRIPE_SECRET_KEY is set (endpoint: https://yourdomain.com/billing/webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PORTFOLIO_MONTHLY=
STRIPE_PRICE_BUNDLE_DESK=
STRIPE_PRICE_BUNDLE_WALL=
STRIPE_PRICE_KIT_DESK=
STRIPE_PRICE_KIT_WALL=
# Ops add-on: USD per property per month (unset = "coming soon"), then npm run stripe:setup for the price id
OPS_PRICE_MONTHLY=
STRIPE_PRICE_OPS_MONTHLY=
