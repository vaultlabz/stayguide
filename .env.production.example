# Production Environment Configuration for Plesk Deployment

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (MySQL on Plesk)
MOCK_DATABASE=false
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# JWT Configuration
JWT_SECRET=your_strong_production_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Admin Configuration
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_admin_password

# Email Configuration (SMTP on domain)
EMAIL_PROVIDER=smtp
FROM_EMAIL=billing@yourdomain.com
FROM_NAME=YourCompany Billing
APP_BASE_URL=https://yourdomain.com

# SMTP Configuration (Domain SMTP)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=billing@yourdomain.com
SMTP_PASS=your_email_password

# Alternative SMTP settings for different providers:
# For cPanel/Plesk default SMTP:
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=billing@yourdomain.com

# For Gmail SMTP (if using Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASS=your_app_password

# For Outlook/Office365 SMTP:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@outlook.com
# SMTP_PASS=your_password
# Behind Plesk nginx: trust one proxy hop for client IPs
TRUST_PROXY=1
