# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# 2026-10-09 08:25, #46: true = in-memory demo data (no MySQL needed); false = MySQL below
MOCK_DATABASE=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=stayguide_dev

# 2026-10-09 08:25, #46: public address used in emails, guest links, QR codes and Stripe redirects.
# Leave empty in dev (taken from each request); production requires https://your-domain
APP_BASE_URL=

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Admin Configuration
ADMIN_EMAIL=admin@stayguide.com
ADMIN_PASSWORD=admin123
# 2026-10-03 11:39, set to 1 when running behind a reverse proxy (Plesk nginx) so rate limits use the real client IP
TRUST_PROXY=

# 2026-10-03 23:06, G3 Stripe Billing (see docs/BILLING_SETUP.md); leave empty to disable billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PORTFOLIO_MONTHLY=
STRIPE_PRICE_BUNDLE_DESK=
STRIPE_PRICE_BUNDLE_WALL=
STRIPE_PRICE_KIT_DESK=
STRIPE_PRICE_KIT_WALL=

# 2026-10-07 16:45, email (invoices, helpdesk replies, urgent guest reports). EMAIL_PROVIDER=mock logs emails to the console;
# smtp sends through nodemailer. SUPPORT_EMAIL receives new helpdesk tickets (falls back to ADMIN_EMAIL).
EMAIL_PROVIDER=mock
FROM_EMAIL=billing@stayguide.com
FROM_NAME=StayGuide
SUPPORT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# 2026-10-08 00:10, G7 Ops: 32-byte key (hex) for access codes, QR tokens and signed photo URLs. Generate: openssl rand -hex 32
OPS_SECRET_KEY=
# 2026-10-08 02:00, where private job photos are stored (default: storage/ops in the app folder; keep it out of public/ and backed up)
OPS_STORAGE_DIR=

# 2026-10-08 06:40, G7 Ops web push for the worker app. Generate once: npx web-push generate-vapid-keys
# Without them dev uses temporary keys (subscriptions reset on restart) and production has push off (email still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@stayguide.com
# 2026-10-08 08:30, G7 Ops hourly checks (insurance reminders; later schedules and overdue alerts). Set to off to disable.
OPS_SCHEDULER=

# 2026-10-08 13:10, G7 Ops add-on price (USD per property per month). Unset = "coming soon". Then run npm run stripe:setup
# and paste STRIPE_PRICE_OPS_MONTHLY. Monthly only (annual Pro subscriptions cannot carry it).
OPS_PRICE_MONTHLY=
STRIPE_PRICE_OPS_MONTHLY=
